<?php
/*
 * wolscheduler.inc
 *
 * Glue between the pfSense GUI and the wolscheduler daemon: validates input,
 * renders /usr/local/etc/wolscheduler.conf and manages the service.
 */

require_once("config.inc");
require_once("globals.inc");
require_once("interfaces.inc");
require_once("service-utils.inc");
require_once("util.inc");

define('WOLSCHED_BIN', '/usr/local/bin/wolscheduler');
define('WOLSCHED_CONF', '/usr/local/etc/wolscheduler.conf');
define('WOLSCHED_PID', '/var/run/wolscheduler.pid');
define('WOLSCHED_STATUS', '/var/run/wolscheduler.status');

function wolscheduler_hosts() {
	return config_get_path('installedpackages/wolscheduler/config', []);
}

function wolscheduler_validate_input($post, &$input_errors) {
	if (!is_macaddr($post['mac'])) {
		$input_errors[] = gettext("A valid MAC address is required (xx:xx:xx:xx:xx:xx).");
	}
	if (!empty($post['broadcast']) && !is_ipaddrv4($post['broadcast'])) {
		$input_errors[] = gettext("Broadcast override must be an IPv4 address.");
	}
	if ($post['port'] !== '' && (!is_numericint($post['port']) || $post['port'] < 1 || $post['port'] > 65535)) {
		$input_errors[] = gettext("UDP port must be between 1 and 65535.");
	}
	if ($post['interval'] !== '' && !is_numericint($post['interval'])) {
		$input_errors[] = gettext("Schedule interval must be a non-negative integer (minutes).");
	}
	if ($post['keepalive'] && !is_ipaddrv4($post['ipaddr'])) {
		$input_errors[] = gettext("Keep-Alive requires a valid IPv4 host address.");
	}
	$ranges = array(
		'ping_interval'  => array(1, 3600, gettext("Ping interval")),
		'ping_timeout'   => array(1, 60, gettext("Ping timeout")),
		'fail_threshold' => array(1, 100, gettext("Failures before down")),
		'wol_retry'      => array(1, 86400, gettext("WOL retry")),
	);
	foreach ($ranges as $key => $r) {
		if ($post[$key] === '' || !isset($post[$key])) {
			continue;
		}
		if (!is_numericint($post[$key]) || $post[$key] < $r[0] || $post[$key] > $r[1]) {
			$input_errors[] = sprintf(gettext("%s must be between %d and %d."), $r[2], $r[0], $r[1]);
		}
	}
	if (!empty($post['keepalive']) && !empty($post['ping_timeout']) &&
	    !empty($post['ping_interval']) && $post['ping_timeout'] > $post['ping_interval']) {
		$input_errors[] = gettext("Ping timeout cannot be greater than the ping interval.");
	}
}

/* Broadcast address for a host entry: override, or the interface subnet broadcast. */
function wolscheduler_broadcast($host) {
	if (!empty($host['broadcast']) && is_ipaddrv4($host['broadcast'])) {
		return $host['broadcast'];
	}
	$ip = get_interface_ip($host['interface']);
	$bits = get_interface_subnet($host['interface']);
	if (is_ipaddrv4($ip) && is_numericint($bits)) {
		return gen_subnet_max($ip, $bits);
	}
	return null;
}

function wolscheduler_intval($value, $default) {
	return (isset($value) && is_numericint($value)) ? (int)$value : $default;
}

function wolscheduler_write_config() {
	$out = "# Generated by pfSense wolscheduler package. Do not edit.\n";
	$count = 0;

	foreach (wolscheduler_hosts() as $host) {
		if (empty($host['enable']) || !is_macaddr($host['mac'])) {
			continue;
		}
		$interval = wolscheduler_intval($host['interval'], 0) * 60;
		$keepalive = !empty($host['keepalive']) && is_ipaddrv4($host['ipaddr']);
		if ($interval == 0 && !$keepalive) {
			continue;
		}
		$bcast = wolscheduler_broadcast($host);
		if ($bcast === null) {
			log_error(sprintf("[wolscheduler] Cannot determine broadcast for %s on %s, skipping.",
			    $host['descr'], $host['interface']));
			continue;
		}
		$name = preg_replace('/[\t\r\n]+/', ' ', $host['descr']);

		$out .= "\n[host]\n";
		$out .= "name = {$name}\n";
		$out .= "mac = {$host['mac']}\n";
		$out .= "broadcast = {$bcast}\n";
		$out .= "port = " . wolscheduler_intval($host['port'], 9) . "\n";
		$out .= "interval = {$interval}\n";
		$out .= "keepalive = " . ($keepalive ? 1 : 0) . "\n";
		if ($keepalive) {
			$out .= "ip = {$host['ipaddr']}\n";
			$out .= "ping_interval = " . wolscheduler_intval($host['ping_interval'], 10) . "\n";
			$out .= "ping_timeout = " . wolscheduler_intval($host['ping_timeout'], 2) . "\n";
			$out .= "fail_threshold = " . wolscheduler_intval($host['fail_threshold'], 3) . "\n";
			$out .= "wol_retry = " . wolscheduler_intval($host['wol_retry'], 30) . "\n";
		}
		$count++;
	}

	file_put_contents(WOLSCHED_CONF, $out);
	return $count;
}

function wolscheduler_write_rcfile() {
	write_rcfile(array(
		"file" => "wolscheduler.sh",
		"start" => WOLSCHED_BIN . " -c " . WOLSCHED_CONF . " -p " . WOLSCHED_PID . " -s " . WOLSCHED_STATUS,
		"stop" => "/bin/pkill -TERM -F " . WOLSCHED_PID . " 2>/dev/null; /usr/bin/killall -q wolscheduler; /bin/rm -f " . WOLSCHED_PID . " " . WOLSCHED_STATUS,
	));
}

function wolscheduler_resync() {
	$count = wolscheduler_write_config();
	wolscheduler_write_rcfile();

	if ($count == 0) {
		if (is_process_running("wolscheduler")) {
			stop_service("wolscheduler");
		}
		return;
	}

	if (isvalidpid(WOLSCHED_PID)) {
		sigkillbypid(WOLSCHED_PID, "HUP");
	} elseif (!platform_booting()) {
		start_service("wolscheduler");
	} else {
		/* At boot, rc.start_packages starts the service itself. */
	}
}

function wolscheduler_deinstall() {
	stop_service("wolscheduler");
	unlink_if_exists(WOLSCHED_CONF);
	unlink_if_exists(WOLSCHED_STATUS);
	unlink_if_exists(WOLSCHED_PID);
}

/* Read the status file written by the daemon. */
function wolscheduler_status() {
	$rows = array();
	if (!file_exists(WOLSCHED_STATUS)) {
		return $rows;
	}
	foreach (file(WOLSCHED_STATUS, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) as $line) {
		if ($line[0] == '#') {
			continue;
		}
		$f = explode("\t", $line);
		if (count($f) < 8) {
			continue;
		}
		$rows[] = array(
			'name' => $f[0],
			'mac' => $f[1],
			'ip' => $f[2],
			'state' => $f[3],
			'last_reply' => (int)$f[4],
			'last_wol' => (int)$f[5],
			'wol_count' => (int)$f[6],
			'next_wol' => (int)$f[7],
			'fails' => isset($f[8]) ? (int)$f[8] : null,
			'fail_threshold' => isset($f[9]) ? (int)$f[9] : null,
		);
	}
	return $rows;
}

/* IPv4 subnets of the configured interfaces: [{if, net, bits}] */
function wolscheduler_interface_subnets() {
	$subnets = array();
	foreach (array_keys(get_configured_interface_with_descr()) as $if) {
		$ifip = get_interface_ip($if);
		$bits = get_interface_subnet($if);
		if (is_ipaddrv4($ifip) && is_numericint($bits)) {
			$subnets[] = array('if' => $if, 'net' => gen_subnet($ifip, $bits), 'bits' => (int)$bits);
		}
	}
	return $subnets;
}

/* Configured interface whose IPv4 subnet contains $ip, or '' if none. */
function wolscheduler_ip_interface($ip, $subnets = null) {
	foreach ($subnets ?? wolscheduler_interface_subnets() as $s) {
		if (ip_in_subnet($ip, "{$s['net']}/{$s['bits']}")) {
			return $s['if'];
		}
	}
	return '';
}

/*
 * DHCP leases and static mappings, one entry per MAC (static mapping wins,
 * then the active lease), sorted by name.
 */
function wolscheduler_dhcp_leases() {
	require_once("system.inc");

	$ifdescr = get_configured_interface_with_descr();
	$subnets = wolscheduler_interface_subnets();
	$leases = system_get_dhcpleases(false);	/* false: no reverse DNS lookups */
	$rank = array('static' => 0, 'active' => 1);
	$bymac = array();

	foreach ($leases['lease'] as $l) {
		if (empty($l['mac']) || !is_macaddr($l['mac']) || !is_ipaddrv4($l['ip'])) {
			continue;
		}
		$mac = strtolower($l['mac']);
		$if = !empty($l['if']) ? $l['if'] : wolscheduler_ip_interface($l['ip'], $subnets);
		$static = ($l['type'] == gettext("static"));
		$state = $static ? 'static' : (($l['act'] == gettext("active")) ? 'active' : 'other');
		$entry = array(
			'mac' => $mac,
			'ip' => $l['ip'],
			'name' => !empty($l['hostname']) ? $l['hostname'] : (string)$l['descr'],
			'if' => $if,
			'ifdescr' => isset($ifdescr[$if]) ? $ifdescr[$if] : strtoupper($if),
			'state' => $state,
			'online' => ($l['online'] == gettext("active")),	/* host is in the ARP table */
		);
		$r = isset($rank[$state]) ? $rank[$state] : 2;
		if (!isset($bymac[$mac]) || $r < $bymac[$mac]['_rank']) {
			$entry['_rank'] = $r;
			$bymac[$mac] = $entry;
		}
	}

	$list = array_values($bymac);
	foreach ($list as &$e) {
		unset($e['_rank']);
	}
	unset($e);
	/* Grouped by interface (unknown subnet last), then by name */
	usort($list, function ($a, $b) {
		if ($a['ifdescr'] !== $b['ifdescr']) {
			if ($a['ifdescr'] === '' || $b['ifdescr'] === '') {
				return ($a['ifdescr'] === '') ? 1 : -1;
			}
			return strcasecmp($a['ifdescr'], $b['ifdescr']);
		}
		return strcasecmp($a['name'] ?: $a['ip'], $b['name'] ?: $b['ip']);
	});
	return $list;
}

/*
 * Host edit page (pkg_edit.php, custom_php_after_head_command): adds a
 * "DHCP lease" selector that fills MAC, interface, IP and description, and
 * fills interface/IP when a known MAC is typed. Manual entry (no lease) works
 * the same way: typing the host IP selects the interface whose subnet has it.
 */
function wolscheduler_dhcp_picker() {
	$jflags = JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT;
	$json = json_encode(wolscheduler_dhcp_leases(), $jflags);
	$subnets = json_encode(wolscheduler_interface_subnets(), $jflags);
	$label = json_encode(gettext("DHCP lease"));
	$placeholder = json_encode(gettext("Select to auto-fill..."));
	$help = json_encode(gettext("Fills MAC, interface, host IP and description from a DHCP lease or static mapping."));
	$none = json_encode(gettext("No DHCP leases found - fill in the fields below manually."));
	echo <<<EOT
<script type="text/javascript">
//<![CDATA[
events.push(function() {
	var leases = {$json};
	var subnets = {$subnets};
	var \$mac = $('#mac');
	if (!\$mac.length) {
		return;
	}

	function apply(l, overwrite) {
		if (overwrite || !\$mac.val()) {
			\$mac.val(l.mac);
		}
		if (l.if && $('#interface option[value="' + l.if + '"]').length) {
			$('#interface').val(l.if).trigger('change');
		}
		if (overwrite || !$('#ipaddr').val()) {
			$('#ipaddr').val(l.ip);
		}
		if (!$('#descr').val() && l.name) {
			$('#descr').val(l.name);
		}
	}

	var \$sel = $('<select class="form-control" id="wolsched_lease"></select>');
	\$sel.append($('<option value=""></option>').text(leases.length ? {$placeholder} : {$none}));
	var groups = {};
	$.each(leases, function(i, l) {
		var g = l.ifdescr || '-';
		if (!groups[g]) {
			groups[g] = $('<optgroup></optgroup>').attr('label', g);
			\$sel.append(groups[g]);
		}
		var text = (l.name ? l.name + ' - ' : '') + l.ip + ' - ' + l.mac +
		    ' (' + l.state + (l.online ? ', online' : '') + ')';
		groups[g].append($('<option></option>').val(i).text(text));
	});
	if (!leases.length) {
		\$sel.prop('disabled', true);
	}
	\$sel.on('change', function() {
		if (this.value !== '') {
			apply(leases[this.value], true);
		}
	});

	var \$row = $('<div class="form-group"></div>')
	    .append($('<label class="col-sm-2 control-label"></label>').append($('<span></span>').text({$label})))
	    .append($('<div class="col-sm-10"></div>').append(\$sel)
	        .append($('<span class="help-block"></span>').text({$help})));
	\$mac.closest('.form-group').before(\$row);

	/* Typed/pasted MAC: fill interface and IP from the matching lease */
	\$mac.on('change', function() {
		var mac = $.trim(this.value).toLowerCase().replace(/-/g, ':');
		if (/^([0-9a-f]{2}:){5}[0-9a-f]{2}$/.test(mac)) {
			this.value = mac;
		}
		$.each(leases, function(i, l) {
			if (l.mac === mac) {
				apply(l, false);
				return false;
			}
		});
	});

	/* Typed host IP (with or without a lease): select the interface of its subnet */
	function ip2int(ip) {
		var p = $.trim(ip).split('.');
		if (p.length !== 4) {
			return null;
		}
		var n = 0;
		for (var i = 0; i < 4; i++) {
			if (!/^[0-9]{1,3}$/.test(p[i]) || +p[i] > 255) {
				return null;
			}
			n = n * 256 + (+p[i]);
		}
		return n;
	}
	$('#ipaddr').on('change', function() {
		var ip = ip2int(this.value);
		if (ip === null) {
			return;
		}
		$.each(subnets, function(i, s) {
			var size = Math.pow(2, 32 - s.bits);
			var net = ip2int(s.net);
			if (net !== null && ip >= net && ip < net + size &&
			    $('#interface option[value="' + s.if + '"]').length) {
				$('#interface').val(s.if).trigger('change');
				return false;
			}
		});
	});
});
//]]>
</script>
EOT;
}

/* Send a magic packet right now (used by the Status page). */
function wolscheduler_send_now($host) {
	$bcast = wolscheduler_broadcast($host);
	if ($bcast === null || !is_macaddr($host['mac'])) {
		return false;
	}
	$port = wolscheduler_intval($host['port'], 9);
	$rc = mwexec(WOLSCHED_BIN . " -w " . escapeshellarg($host['mac']) .
	    " -b " . escapeshellarg($bcast) . " -P " . escapeshellarg($port));
	if ($rc == 0) {
		log_error(sprintf("[wolscheduler] Manual WOL sent to %s (%s) via %s.", $host['descr'], $host['mac'], $bcast));
	}
	return ($rc == 0);
}
